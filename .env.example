# Copy this file to .env and fill in your own values. Never commit .env.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-your-own-secret-key

# True only on your own machine.
DEBUG=True

# Comma-separated host names the app may be served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/attendance_dev

# True when served over HTTPS (production); False for local development.
SECURE_COOKIES=False

# Two-factor login (one-time codes after the password). Keep True; set False only on your
# own machine to try the app without an authenticator app.
OTP_REQUIRED=True

# Email. The console backend prints emails in the terminal (development).
# For real delivery use django.core.mail.backends.smtp.EmailBackend and fill in the SMTP values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Student Attendance <noreply@attendance.local>
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
# Public application origin for login-details emails. HTTPS is required when DEBUG=False.
# Never derive this link from a user-supplied request Host header.
SITE_URL=http://127.0.0.1:8000

# Encrypted backups (BL-26/27). Keep this key outside the backup store, with a secure
# recovery copy. Losing it makes existing backups unreadable. Never commit a real key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=
# Default: var/backups inside the checkout, ignored by Git. Use a private directory
# outside any web-served storage; its permissions must be 0700.
# BACKUP_DIRECTORY=/srv/attendance-backups
BACKUP_MAX_BYTES=268435456
BACKUP_LOCK_TIMEOUT_SECONDS=10
