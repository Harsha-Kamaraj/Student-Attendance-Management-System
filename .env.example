# Copy this file to .env and fill in your own values. Never commit .env.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-your-own-secret-key

# True only on your own machine.
DEBUG=True

# Comma-separated host names the app may be served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/attendance_dev

# True when served over HTTPS (production); False for local development.
SECURE_COOKIES=False
